{
  "name": "@atelia/pg-change-context",
  "version": "0.1.1",
  "description": "Emit application context alongside PostgreSQL data changes for logical-decoding CDC",
  "keywords": [
    "postgresql",
    "cdc",
    "change-data-capture",
    "logical-decoding",
    "audit",
    "prisma"
  ],
  "homepage": "https://github.com/ateliahealth/bemi-io/tree/main/context#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ateliahealth/bemi-io.git",
    "directory": "context"
  },
  "bugs": {
    "url": "https://github.com/ateliahealth/bemi-io/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "format": "prettier --write --ignore-path ../.prettierignore src",
    "format:check": "prettier --check --ignore-path ../.prettierignore src",
    "lint": "oxlint src",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@types/node": "catalog:",
    "prisma": "^6.5.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
