{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format:check": {},
    "prisma:generate": {
      "cache": false,
      "outputs": []
    },
    "@atelia/pg-change-context#typecheck": {
      "dependsOn": ["^build", "@atelia/pg-change-context#prisma:generate"]
    }
  }
}
