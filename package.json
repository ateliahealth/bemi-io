{
  "name": "bemi-io",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky || true",
    "license:add": "./scripts/license-notice.sh backfill",
    "license:check": "./scripts/license-notice.sh check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "format:check": "turbo run format:check"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "oxlint": "^1.77.0",
    "prettier": "^3.3.0",
    "turbo": "^2.9.5"
  }
}
