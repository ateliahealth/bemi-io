{
  "name": "bemi-io",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "license:add": "./scripts/license-notice.sh backfill",
    "license:check": "./scripts/license-notice.sh check",
    "lint": "oxlint core/src worker/src worker/mikro-orm.config.ts",
    "lint:fix": "pnpm run lint --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build"
  },
  "devDependencies": {
    "oxlint": "^1.77.0",
    "turbo": "^2.9.5"
  }
}
