{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "es2022",
    // node16, not commonjs/node10: TS 7 removes node10 outright, not just
    // deprecates it. Both packages are CommonJS (no "type": "module"), so
    // node16 still emits CJS - it changes resolution, not the output format.
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    // MikroORM entities carry decorators and the ORM reads the emitted
    // design:type metadata to infer column types, so both of these are
    // load-bearing rather than stylistic. Dropping either makes the ORM fall
    // back to guessing, which fails at runtime rather than at compile time.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
