{
  "name": "@bemi-db/worker",
  "private": true,
  "dependencies": {
    "@bemi-db/core": "workspace:*",
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/migrations": "catalog:",
    "@mikro-orm/postgresql": "catalog:",
    "@mikro-orm/sql-highlighter": "catalog:",
    "@nats-io/jetstream": "catalog:",
    "@nats-io/transport-node": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src mikro-orm.config.ts",
    "format": "prettier --write --ignore-path ../.prettierignore src mikro-orm.config.ts",
    "format:check": "prettier --check --ignore-path ../.prettierignore src mikro-orm.config.ts"
  }
}
