{
  "name": "@bemi-db/core",
  "version": "0.1.0",
  "private": true,
  "description": "Automatic data change tracking for PostgreSQL",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write --ignore-path ../.prettierignore src",
    "format:check": "prettier --check --ignore-path ../.prettierignore src",
    "lint": "oxlint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ateliahealth/bemi-io.git",
    "directory": "core"
  },
  "author": "",
  "license": "SSPL-1.0",
  "bugs": {
    "url": "https://github.com/ateliahealth/bemi-io/issues"
  },
  "homepage": "https://github.com/ateliahealth/bemi-io#readme",
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/decorators": "catalog:",
    "@mikro-orm/migrations": "catalog:",
    "@mikro-orm/postgresql": "catalog:",
    "@nats-io/jetstream": "catalog:",
    "@nats-io/nats-core": "catalog:",
    "@nats-io/transport-node": "catalog:",
    "reflect-metadata": "^0.2.2"
  }
}
